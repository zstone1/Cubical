import CubeChains.Concurrency.Presentation.CutPresentation
import CubeChains.Concurrency.Presentation.ElementsFibration
import CubeChains.Concurrency.Presentation.PosLocalization
import CubeChains.Machinery.Localization.ElementsPresentation
import CubeChains.Machinery.Braid.PosAction

/-!
# Concurrency/Presentation/LiftPresentation — a presentation of `Ch Zbp` lifts to `Ch K`

`Ch K` is the category of elements of `⋁- ⟶ K` over `Ch Zbp` (`chEquivElements`), so
`Machinery/Localization/ElementsPresentation` applies verbatim: a presentation of the base gives
one of `Ch K`, generators the base generators acting on a chain, relations the base relations.
Under `IsSegal K` the same holds after inverting the merges — which is where a `BraidPresentation`
enters, once and for both of its instances.

The **vertex monoids do not follow**: `End` at a chain is a stabilizer (`endEquivStabilizer`), and
`PosBraidAction` shows a stabilizer need not be generated by the generators sitting at its object —
there the generators that are loops are only the identity, while the loops are `PosPureBraid n`.
-/

open CategoryTheory CategoryTheory.MonoidalCategory Opposite CubeChains BPSet

universe v u

namespace ChainCat

/-! ## The category presentation transports -/

section Transport

variable (K : BPSet) {V : Type u} [Quiver.{v} V] (r : HomRel (Paths V))

/-- **A presentation of the serial-wedge category presents `Ch K`.**  The total quiver's vertices
are a base object together with a chain of `K` over it; its edges are the base's generators acting
on such a chain; its relations are the base's, read on projected paths. -/
noncomputable def chPresentation (e : Quotient r ≌ (Ch Zbp)ᵒᵖ) :
    Ch K ≌ (Quotient (totalRel r (e.functor ⋙ wedgeHoms K)))ᵒᵖ :=
  (chEquivElements K).trans
    (((elementsPresentation r (e.functor ⋙ wedgeHoms K)).trans
      (CategoryOfElements.preEquivalenceComp (wedgeHoms K) e)).op).symm

variable (hK : IsSegal K.toPsh)

/-- **The same after inverting the merges.**  `W K` is pulled back from the base, so once
`⋁- ⟶ K` inverts the merges a presentation of the localized base presents `Ch K[W⁻¹]`. -/
noncomputable def chLocPresentation
    (e : Quotient r ≌ ((W Zbp).op).Localization) :
    (W K).Localization ≌
      (Quotient (totalRel r (e.functor ⋙ wedgeHomsDescend K hK)))ᵒᵖ :=
  haveI : (chDescent K hK).IsLocalization (W K) := isLocalization_chDescent K hK
  (Localization.equivalenceFromModel (chDescent K hK) (W K)).trans
    (((elementsPresentation r (e.functor ⋙ wedgeHomsDescend K hK)).trans
      (CategoryOfElements.preEquivalenceComp (wedgeHomsDescend K hK) e)).op).symm

end Transport

/-! ## The base presentation, supplied

`Concurrency/Presentation/CutPresentation` presents `(Ch Zbp)ᵒᵖ` by its bead cuts — exactly the
hypothesis above. -/

/-- **`Ch K` is presented by the bead cuts acting on a chain.** -/
noncomputable def chCutPresentation (K : BPSet) :
    Ch K ≌ (Quotient (totalRel Cut.rel (zPresentationOp.functor ⋙ wedgeHoms K)))ᵒᵖ :=
  chPresentation K Cut.rel zPresentationOp

/-! ## The chain a generator sits at

`Construction.fac` is an *equality*, so the descended fibre over `Q(op a)` is literally the maps of
`⋁a` into `K`; and a braid presentation's vertex at strand count `m` is isomorphic to `Q(op 1ᵐ)`
because `FullPosBraid` has no morphisms between degrees. -/

section Fibre

private theorem locFullOpEquiv_functor_inverse_obj (Y : FullPosBraidᵒᵖ) :
    locFullOpEquiv.functor.obj (locFullOpEquiv.inverse.obj Y) = Y :=
  Opposite.unop_injective (locFullOpEquiv.counitIso.app Y).hom.unop.deg.symm

/-- The localized base at strand count `m`, named by the run of `m` edges. -/
theorem locFullOpEquiv_obj_Q_ones (m : ℕ) :
    locFullOpEquiv.functor.obj ((W Zbp).op.Q.obj (op (zObj (𝟙^m))))
      = op (m : FullPosBraid) :=
  (Functor.congr_obj (Localization.Construction.fac ((chPosBraid Zbp).op)
    (Localization.inverts ((chPosBraid Zbp).op) ((W Zbp).op))) (op (zObj (𝟙^m)))).trans
    (congrArg op (dimSum_replicate m))

variable (K : BPSet) (hK : IsSegal K.toPsh)

/-- **The descended fibre over a chain is the maps of that wedge into `K`.** -/
theorem wedgeHomsDescend_obj_Q (a : Ch Zbp) :
    (wedgeHomsDescend K hK).obj ((W Zbp).op.Q.obj (op a)) = (wedgeHoms K).obj (op a) :=
  Functor.congr_obj (Localization.Construction.fac (wedgeHoms K) (invertsMerges_of_isSegal K hK))
    (op a)

/-- **A vertex sitting over strand count `m` carries the chains of `K` with `m` unit beads.** -/
noncomputable def locFibreEquiv {C : Type u} [Category.{v} C]
    (F : C ⥤ ((W Zbp).op).Localization) (Z : C) (m : ℕ)
    (h : locFullOpEquiv.functor.obj (F.obj Z) = op (m : FullPosBraid)) :
    (F ⋙ wedgeHomsDescend K hK).obj Z ≃ (wedgeHoms K).obj (op (zObj (𝟙^m))) :=
  ((wedgeHomsDescend K hK).mapIso (locFullOpEquiv.functor.preimageIso
    (eqToIso (h.trans (locFullOpEquiv_obj_Q_ones m).symm)))).toEquiv.trans
      (Equiv.cast (wedgeHomsDescend_obj_Q K hK (zObj (𝟙^m))))

end Fibre

/-! ## The vertex monoids do not

`End` at a chain is the stabilizer of its classifying map, `ᵐᵒᵖ` because `Ch K` is the *opposite*
of the category of elements.  A stabilizer is not read off the ambient generators. -/

section Stabilizer

/-- **The loops at a chain are the stabilizer of its classifying map.** -/
noncomputable def endEquivStabilizer (K : BPSet) (a : Ch K) :
    End a ≃* (CategoryOfElements.stabilizer (wedgeHoms K)
      (unop ((toElements K).obj a)))ᵐᵒᵖ :=
  ((Functor.FullyFaithful.ofFullyFaithful (toElements K)).mulEquivEnd a).trans
    (CategoryOfElements.endOpEquivStabilizer _ _)

end Stabilizer

/-! ## A stabilizer is not generated by the generators at its object

`PosBraidAction n` is the category of elements of the positive braids acting on the orderings.  Its
generators are the simples `posPerm σ`; the action is free, so the only generator that is a loop is
the identity, while the loops at any ordering are all of `PosPureBraid n`. -/

section Counterexample

open Equiv

variable {n : ℕ}

/-- A simple generator that is a loop is the identity — multiplication is free. -/
theorem eq_id_of_val_eq_posPerm {p : PosBraidAction n} (f : @End (PosBraidAction n) _ p)
    (σ : Perm (Fin n)) (h : f.val = posPerm σ) : f = 𝟙 p := by
  have h2 : posPermHom n f.val * p.back = p.back := f.2
  rw [h, posPermHom_posPerm, mul_eq_right] at h2
  exact Subtype.ext (by rw [h, h2, posPerm_one, ActionCategory.id_val])

/-- The `k`-th adjacent transposition is not the identity. -/
private theorem adjT_ne_one (k : Fin (n - 1)) : adjT k ≠ 1 := by
  intro h
  have h1 : adjHi k = adjLo k := by rw [← adjT_lo k, h]; rfl
  have := congrArg Fin.val h1
  simp only [adjHi_val, adjLo_val] at this
  omega

/-- **The loops at an ordering are not all trivial** — the square of an atom is pure and nonzero
in the writhe. -/
theorem exists_end_ne_id (hn : 2 ≤ n) (p : PosBraidAction n) :
    ∃ f : @End (PosBraidAction n) _ p, f ≠ 𝟙 p := by
  have hi : 0 < n - 1 := by omega
  set k : Fin (n - 1) := ⟨0, hi⟩ with hk
  have hsq : adjT k * adjT k = 1 := by rw [adjT, swap_mul_self]
  have hfix : posPermHom n (posPerm (adjT k) * posPerm (adjT k)) * p.back = p.back := by
    rw [map_mul, posPermHom_posPerm, hsq, one_mul]
  refine ⟨⟨posPerm (adjT k) * posPerm (adjT k), hfix⟩, ?_⟩
  intro hcon
  have h1 : posPerm (adjT k) * posPerm (adjT k) = 1 :=
    (congrArg Subtype.val hcon).trans (ActionCategory.id_val p)
  have hw : ((permLen (adjT k) : ℤ)) + (permLen (adjT k) : ℤ) = 0 := by
    have h2 := congrArg (Multiplicative.toAdd ∘ posWrithe n) h1
    simpa [← ofAdd_add] using h2
  exact adjT_ne_one k (eq_one_of_permLen_eq_zero _ (by omega))

/-- **The vertex monoid is not generated by the generators sitting at its object.**  Every simple
that is a loop at `p` is the identity, so those generators span the trivial submonoid — while
`End p` is `PosPureBraid n`, which for `n ≥ 2` is not trivial.  Transporting a presentation to the
total category (`chPresentation`) therefore says nothing about its `End`s. -/
theorem end_not_generated_by_simples (hn : 2 ≤ n) (p : PosBraidAction n) :
    Submonoid.closure {f : @End (PosBraidAction n) _ p | ∃ σ : Perm (Fin n), f.val = posPerm σ}
      ≠ ⊤ := by
  intro hcon
  obtain ⟨f, hf⟩ := exists_end_ne_id hn p
  have hle : Submonoid.closure
      {f : @End (PosBraidAction n) _ p | ∃ σ : Perm (Fin n), f.val = posPerm σ} ≤ ⊥ := by
    rw [Submonoid.closure_le]
    rintro g ⟨σ, hσ⟩
    exact Submonoid.mem_bot.mpr (eq_id_of_val_eq_posPerm g σ hσ)
  rw [hcon] at hle
  exact hf (Submonoid.mem_bot.mp (hle (Submonoid.mem_top f)))

end Counterexample

end ChainCat

/-! ## The braid presentations, transported

Everything a presentation of `PosBraid` gives about `Ch K[W⁻¹]`, said once. -/

namespace CubeChains.BraidPresentation

open ChainCat

variable (P : BraidPresentation) (K : BPSet) (hK : IsSegal K.toPsh)

/-- The chains of `K`, as a presheaf on the presented base. -/
noncomputable abbrev pd : Quotient P.pathRel ⥤ Type := P.locEquiv.functor ⋙ wedgeHomsDescend K hK

/-- **`Ch K[W⁻¹]` is presented by the generators acting on a chain**: a generator is one of `P`'s
generators at the event count of a chain of `K`, and the relations are `P`'s. -/
noncomputable def chLocEquiv :
    (W K).Localization ≌ (Quotient (totalRel P.pathRel (P.pd K hK)))ᵒᵖ :=
  chLocPresentation K P.pathRel hK P.locEquiv

theorem locEquiv_obj (m : ℕ) :
    locFullOpEquiv.functor.obj
        (P.locEquiv.functor.obj ((Quotient.functor P.pathRel).obj (Sigma.wordVtx m)))
      = op (m : FullPosBraid) :=
  locFullOpEquiv_functor_inverse_obj (op m)

/-- **The generators at strand count `m` sit at the chains of `K` with `m` unit beads.** -/
noncomputable def fibreEquiv (m : ℕ) :
    Sigma.wordFibre (P.pd K hK) m ≃ (wedgeHoms K).obj (op (zObj (𝟙^m))) :=
  locFibreEquiv K hK _ _ m (P.locEquiv_obj m)

end CubeChains.BraidPresentation
